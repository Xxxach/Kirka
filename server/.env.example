CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# Заполнишь, когда пополнишь баланс на DeepSeek через агрегатор (например AITUNNEL)
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

PORT=3001

# Домен, с которого разрешено ходить в API (без слэша на конце)
FRONTEND_ORIGIN=http://localhost:5173

# Уведомления владельцу в Telegram (фидбэк, ошибки сайта, сбои ИИ).
# Токен берёшь у @BotFather, TG_CHAT_ID - твой числовой id (см. инструкцию).
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если сервер не достаёт до api.telegram.org напрямую, шлём через Cloudflare Worker
# (код в cloudflare/telegram-relay.js). Тогда TG_BOT_TOKEN и TG_CHAT_ID живут в Worker.
TG_RELAY_URL=
TG_RELAY_KEY=
